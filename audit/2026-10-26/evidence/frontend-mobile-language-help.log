npm notice run marker@0.1.0 npx
npm notice run playwright-cli -s=marker-audit-frontend eval async () => { const actual = {lang: document.documentElement.lang, width: innerWidth, scrollWidth: document.documentElement.scrollWidth, product: document.querySelector("select[name=productId]")?.selectedOptions[0]?.textContent, draft: document.querySelector("input[name=title]")?.value, caches: await caches.keys(), guide: document.querySelector(".help-dialog h3")?.textContent, image: document.querySelector(".help-screenshot img")?.getAttribute("src"), imageLoaded: !!document.querySelector(".help-screenshot img")?.naturalWidth }; if (actual.lang !== "es" || actual.width !== 390 || actual.scrollWidth > actual.width || actual.caches.length || !actual.imageLoaded || actual.draft !== "AUDIT CAMPAIGN UI STALE") throw Error(JSON.stringify(actual)); return actual; }
